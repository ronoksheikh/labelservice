{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "twobytes",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // The Worker answers the API and renders public pages with SEO tags; everything else is the static React app.
    "run_worker_first": [
      "/api/*", "/", "/courses/*", "/about", "/privacy", "/terms", "/refunds", "/robots.txt", "/sitemap.xml", "/media/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "twobytes",
      // Replace with the id printed by `bunx wrangler d1 create twobytes`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    // Course images uploaded from the admin panel, served at /media/*. Create with `bunx wrangler r2 bucket create twobytes-media`.
    { "binding": "MEDIA", "bucket_name": "twobytes-media" }
  ],
  "vars": {
    "SITE_URL": "https://twobytes.dev",
    "EMAIL_FROM": "twobytes.dev <hello@twobytes.dev>",
    "EMAIL_REPLY_TO": "hello@twobytes.dev"
  },
  // Serves the site on twobytes.dev (the domain must be on this Cloudflare account). Remove to deploy on workers.dev only.
  "routes": [{ "pattern": "twobytes.dev", "custom_domain": true }],
  // Secrets (bunx wrangler secret put …): SESSION_SECRET, ADMIN_PASSWORD, RESEND_API_KEY
  "observability": { "enabled": true }
}
