{
  "name": "arvono-labels",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A local PDF label importer and print studio for ARVONO.",
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "bun@1.3.10",
  "scripts": {
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "dev": "bun --watch src/index.ts",
    "test": "bun run build && node --test test/*.test.mjs",
    "test:rest": "node scripts/test-rest-api.mjs",
    "samples": "bun run build && node scripts/samples.mjs",
    "samples:a4": "bun run build && node scripts/a4-samples.mjs",
    "samples:thermal": "bun run build && node scripts/thermal-samples.mjs"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.11",
    "bwip-js": "^4.11.4",
    "fastify": "^5.12.7",
    "fflate": "^0.8.3",
    "pdfjs-dist": "^6.4.299",
    "pdfkit": "^0.20.2",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pdfkit": "^0.17.6",
    "typescript": "^7.0.2"
  }
}
